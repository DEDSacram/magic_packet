# Copy to .env and fill in.

# Required. Passphrase required to trigger a wake.
# Generate one with: sh scripts/gen-secret.sh
WOL_SECRET=

# Required. MAC address of the target PC.
WOL_TARGET_MAC=04:7c:16:6d:f6:26

# Cloudflare tunnel token. Zero Trust dashboard > Networks > Tunnels > your
# tunnel > Configure > Install connector. Copy the token from the
# `docker run cloudflare/cloudflared:latest tunnel run` command.
TUNNEL_TOKEN=

# Optional.
# WOL_BROADCAST=192.168.88.255
# WOL_REPEATS=3
# PORT=8099
